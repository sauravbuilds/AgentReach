# Optional. Everything works without a .env file.

# Postgres connection string. Without it the app stores chats in a local SQLite file
# (fine on a laptop). On Vercel, set this (the Neon integration does it for you) so history is kept.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: 1-2 line AI summaries instead of post excerpts. Costs money per search.
# ANTHROPIC_API_KEY=
# SUMMARY_MODEL=claude-haiku-5-5

# Optional: only needed if the frontend is served from a different origin than the API.
# FRONTEND_ORIGIN=http://localhost:5173
